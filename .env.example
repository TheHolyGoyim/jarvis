# ──────────────────────────────────────────────────────────────────────────────
# JARVIS Configuration — copy this to .env and fill in your values.
# Your .env is personal — never share or commit it.
# ──────────────────────────────────────────────────────────────────────────────

# What should JARVIS call you?
JARVIS_USER_NAME="Your Name"

# ── AI Brain (Ollama model) ───────────────────────────────────────────────────
# The local model JARVIS thinks with. Pulled automatically by START_JARVIS.bat.
# qwen2.5:14b-instruct needs ~12GB VRAM/RAM. Smaller fallback: qwen2.5:7b-instruct
# (Game AI modules use llama3 separately for lower latency — optional.)
JARVIS_MODEL="qwen2.5:14b-instruct"

# Auto-generated on first run — do not share this key.
# Used to authenticate your phone when connecting remotely.
JARVIS_API_KEY=""

# ── Remote Access via ngrok (optional) ───────────────────────────────────────
# Free account at https://ngrok.com
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=""

# ── Alpaca Markets — Trading Account ─────────────────────────────────────────
# Free account at https://alpaca.markets
# Paper trading is FREE and requires no real money.
#
# STEP 1: Sign up at https://alpaca.markets
# STEP 2: Go to Paper Trading → API Keys → Generate New Key
# STEP 3: Paste your key and secret below
# STEP 4: Keep ALPACA_BASE_URL as paper until you're ready to go live
#
ALPACA_API_KEY=""
ALPACA_API_SECRET=""
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
#
# To switch to LIVE trading (real money — be careful):
# ALPACA_BASE_URL="https://api.alpaca.markets"

# ── Trading Risk Controls ─────────────────────────────────────────────────────
# All capital limits are LIVE and PERCENT-BASED: JARVIS reads buying power
# from the Alpaca account (GET /v2/account) and applies the Markets-dashboard
# risk parameters (max position %, daily loss %, cash reserve %, risk profile).
# Adjust them in the 📈 Markets tab — there is no dollar cap in this file.
# (The old TRADING_BUDGET hard cap is retired.)

# Optional fallback capital target for display when no goal is set via the
# goal engine ("turn 100k into 150k by end of July" in chat sets a real goal).
TRADING_GOAL="10000"

# ── Grok (xAI) — optional supplementary reasoning tool ───────────────────────
# Get a key at https://console.x.ai. Not required — Jarvis's local Ollama
# model works fully offline without it. When set, adds an "ask_grok" tool
# for harder reasoning / very current events / a second opinion (never used
# for trade execution decisions — those stay on the local conviction engine).
XAI_API_KEY=""
GROK_MODEL="grok-4-latest"
